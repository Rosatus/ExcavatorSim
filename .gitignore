# godot debug build artifact (stray, git-tracked import never existed)
godot/client/addons/terrain_3d/bin/~libterrain.windows.debug.x86_64.dll

# Map authoring workspaces: version the authoring layer (scene layout, lighting,
# materials, shaders, terrain data, import settings) so layout edits are tracked
# and pushed. Static art assets (textures / meshes) stay local -- the Unreal
# project at E:\projects\unreal\ConstructionEnvironment is their cold backup.
# NOTE: .exr / .hdr are deliberately NOT ignored: sky HDRI is lighting content.
/godot/worldbuilding/**/*.png
/godot/worldbuilding/**/*.glb
/godot/worldbuilding/**/*.fbx
/godot/worldbuilding/**/*.obj
/godot/worldbuilding/**/*.blend
/godot/worldbuilding/**/*.jpg
/godot/worldbuilding/**/*.jpeg
/godot/worldbuilding/**/*.tga
/godot/worldbuilding/**/*.psd
/godot/worldbuilding/**/*.wav
/godot/worldbuilding/**/*.ogg
/godot/worldbuilding/**/*.mp3
/godot/worldbuilding/**/*.mp4

# Godot import cache and the addons bootstrap copies (both regenerated locally)
/godot/worldbuilding/**/.godot/
/godot/worldbuilding/**/addons/
/godot/worldbuilding/**/*.tmp
/godot/worldbuilding/**/*.TMP

# large local asset archives and editor tool state (regenerated/local-only)
godot/worldbuilding/**/*.zip
.workbuddy/

# Local manual driving captures and one-off attachment inspection output.
/backend/scripts/godot/recordings/
/xtr13_inspect.json

# Editor-generated runnable preset for the local map-authoring project.
/godot/worldbuilding/construction/export_presets.cfg
