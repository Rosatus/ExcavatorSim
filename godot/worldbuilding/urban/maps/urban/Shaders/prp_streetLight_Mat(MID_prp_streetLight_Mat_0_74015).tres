}
vec2 direction_to_latlong_uv(vec3 pdir) {
    // dir must be normalized
    float longitude = atan(pdir.z, pdir.x);
    float latitude = asin(clamp(pdir.y, -1.0, 1.0));

    // longitude: [-PI, PI] -> [0,1]
    float Outu = longitude / (2.0 * 3.14159265) + 0.5;
    // latitude: [-PI/2, PI/2] -> [0,1]
    float Outv = latitude / 3.14159265 + 0.5;

    return vec2(Outu, Outv);
}
vec3 UnpackNormalmap(vec4 packednormal)
{
    // This do the trick
   //packednormal.x *= packednormal.w;

    vec3 ret_normal;
    ret_normal.xy = packednormal.xy * vec2( 2.0, 2.0 ) - vec2( 1.0, 1.0 );
    ret_normal.z = sqrt(1.0 - saturate(dot(ret_normal.xy, ret_normal.xy)));
    return normalize( ret_normal );
}
#define atanFast atan
float hash2(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise2(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);

    // Smooth factor
    vec3 Localu = f * f * (3.0 - 2.0 * f);

    // Lerp noise values from the 8 corners
    return mix(
        mix(
            mix(hash2(i + vec3(0,0,0)), hash2(i + vec3(1,0,0)), Localu.x),
            mix(hash2(i + vec3(0,1,0)), hash2(i + vec3(1,1,0)), Localu.x),
        Localu.y),
        mix(
            mix(hash2(i + vec3(0,0,1)), hash2(i + vec3(1,0,1)), Localu.x),
            mix(hash2(i + vec3(0,1,1)), hash2(i + vec3(1,1,1)), Localu.x),
        Localu.y),
    Localu.z);
}
vec3 vector_noise_for_WPO( vec3 p )
{	//remove this in Unreal when testing
	p*= vec3(0.01);
	#define HASH33(p) fract(sin(vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)))) * 43758.5453123)

    vec3 _i = floor(p); 
    vec3 _f = fract(p); 
    vec3 _u = _f * _f * _f * (_f * (_f * 6.0 - 15.0) + 10.0);
    return mix( 
        mix(mix(HASH33(_i+vec3(0,0,0)), HASH33(_i+vec3(1,0,0)), _u.x), mix(HASH33(_i+vec3(0,1,0)), HASH33(_i+vec3(1,1,0)), _u.x), _u.y), 
        mix(mix(HASH33(_i+vec3(0,0,1)), HASH33(_i+vec3(1,0,1)), _u.x), mix(HASH33(_i+vec3(0,1,1)), HASH33(_i+vec3(1,1,1)), _u.x), _u.y), 
        _u.z 
    ) * vec3(2.0,2.0,2.0) - vec3(1.0,1.0,1.0);
}
