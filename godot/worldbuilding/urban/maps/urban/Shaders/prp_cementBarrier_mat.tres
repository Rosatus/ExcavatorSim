expression = "//Exported with UnrealToGodot : https://www.fab.com/listings/61983625-664c-4308-9b26-edfd58d41002
float saturate(float val)
{
	return clamp( val, 0.0, 1.0 );
}
vec2 saturate2(vec2 val)
{
	return clamp( val, 0.0, 1.0 );
}
vec3 saturate3(vec3 val)
{
	return clamp( val, 0.0, 1.0 );
}
vec2 mul( mat2 mat, vec2 vector )
{
	return mat * vector;
}
float rcp(float val)
{
	return 1.0 / val;
}
void sincos( float inputx, out float outsin, out float outcos )
{
	outsin = sin(inputx);
	outcos = cos(inputx);
}
vec2 UnitVectorToOctahedron( vec3 Nparam )
{
Nparam.xy /= vec2( dot( vec3(1.0,1.0,1.0), abs(Nparam) ), dot( vec3(1.0,1.0,1.0), abs(Nparam) ) );
if( Nparam.z <= 0.0 )
{
	vec2 val = vec2(-1,-1);	if ( Nparam.x >= 0.0 && Nparam.y >= 0.0 ) val = vec2(1,1);	Nparam.xy = ( 1.0 - abs(Nparam.yx) ) * val;
}
return Nparam.xy;
}
vec3 RotateAboutAxis(vec4 NormalizedRotationAxisAndAngle, vec3 PositionOnAxis, vec3 pPosition)
{
vec3 ClosestPointOnAxis = PositionOnAxis + NormalizedRotationAxisAndAngle.xyz * dot(NormalizedRotationAxisAndAngle.xyz, pPosition - PositionOnAxis);
vec3 UAxis = pPosition - ClosestPointOnAxis;
vec3 VAxis = cross(NormalizedRotationAxisAndAngle.xyz, UAxis);
float CosAngle;
float SinAngle;
sincos(NormalizedRotationAxisAndAngle.w, SinAngle, CosAngle); 
vec3 pR = UAxis * CosAngle + VAxis * SinAngle;
vec3 RotatedPosition = ClosestPointOnAxis + pR;
return RotatedPosition - pPosition;
}
vec3 hash_noise_range_UTG( vec3 p ) {
p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
return 2.0 * fract(fract(p)*4375.55) -1.;
}

void ComputeComplexIORFromF0AndEdgeTintA(
    in vec3 Reflectivity, 
    in vec3 EdgeTint, 
    inout vec3 n, 
    inout vec3 k)
{
    vec3 g = EdgeTint;
    vec3 r = clamp(Reflectivity, 0.0, 0.999);
    vec3 SqrtR = sqrt(r);

    n = g * (1.0 - r) / (1.0 + r) + (1.0 - g) * (1.0 + SqrtR) / (1.0 - SqrtR);

    vec3 k2 = ((n + 1.0) * (n + 1.0) * r - (n - 1.0) * (n - 1.0)) / (1.0 - r);
    k = sqrt(k2);
}
vec2 direction_to_latlong_uv(vec3 pdir) {
    // dir must be normalized
    float longitude = atan(pdir.z, pdir.x);
    float latitude = asin(clamp(pdir.y, -1.0, 1.0));

    // longitude: [-PI, PI] -> [0,1]
    float Outu = longitude / (2.0 * 3.14159265) + 0.5;
    // latitude: [-PI/2, PI/2] -> [0,1]
    float Outv = latitude / 3.14159265 + 0.5;

    return vec2(Outu, Outv);
}
vec3 UnpackNormalmap(vec4 packednormal)
{
    // This do the trick
   //packednormal.x *= packednormal.w;

    vec3 ret_normal;
    ret_normal.xy = packednormal.xy * vec2( 2.0, 2.0 ) - vec2( 1.0, 1.0 );
    ret_normal.z = sqrt(1.0 - saturate(dot(ret_normal.xy, ret_normal.xy)));
    return normalize( ret_normal );
}
#define atanFast atan
float hash2(vec3 p) {
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise2(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);

    // Smooth factor
    vec3 Localu = f * f * (3.0 - 2.0 * f);

    // Lerp noise values from the 8 corners
    return mix(
        mix(
            mix(hash2(i + vec3(0,0,0)), hash2(i + vec3(1,0,0)), Localu.x),
            mix(hash2(i + vec3(0,1,0)), hash2(i + vec3(1,1,0)), Localu.x),
        Localu.y),
        mix(
            mix(hash2(i + vec3(0,0,1)), hash2(i + vec3(1,0,1)), Localu.x),
            mix(hash2(i + vec3(0,1,1)), hash2(i + vec3(1,1,1)), Localu.x),
        Localu.y),
    Localu.z);
}
vec3 vector_noise_for_WPO( vec3 p )
{	//remove this in Unreal when testing
	p*= vec3(0.01);
	#define HASH33(p) fract(sin(vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)))) * 43758.5453123)

    vec3 _i = floor(p); 
    vec3 _f = fract(p); 
    vec3 _u = _f * _f * _f * (_f * (_f * 6.0 - 15.0) + 10.0);
    return mix( 
        mix(mix(HASH33(_i+vec3(0,0,0)), HASH33(_i+vec3(1,0,0)), _u.x), mix(HASH33(_i+vec3(0,1,0)), HASH33(_i+vec3(1,1,0)), _u.x), _u.y), 
        mix(mix(HASH33(_i+vec3(0,0,1)), HASH33(_i+vec3(1,0,1)), _u.x), mix(HASH33(_i+vec3(0,1,1)), HASH33(_i+vec3(1,1,1)), _u.x), _u.y), 
        _u.z 
    ) * vec3(2.0,2.0,2.0) - vec3(1.0,1.0,1.0);
}
"

