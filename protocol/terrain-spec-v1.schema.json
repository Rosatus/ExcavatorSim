{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-pinocchio.local/protocol/terrain-spec-v1.schema.json",
  "title": "TerrainSpec",
  "oneOf": [
    { "$ref": "#/$defs/FlatTerrainSpec" },
    { "$ref": "#/$defs/SlopeTerrainSpec" },
    { "$ref": "#/$defs/TrenchTerrainSpec" },
    { "$ref": "#/$defs/ProfileTerrainSpec" }
  ],
  "$defs": {
    "Extent": { "type": "number", "minimum": 5, "maximum": 50 },
    "Spacing": { "type": "number", "minimum": 0.25, "maximum": 1 },
    "Seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "Point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "FlatTerrainSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain_spec_version", "kind", "width_m", "depth_m", "spacing_m",
        "elevation_m", "seed", "noise_amplitude_m", "noise_scale_m"
      ],
      "properties": {
        "terrain_spec_version": { "const": "terrain-spec-v1" },
        "kind": { "const": "flat" },
        "width_m": { "$ref": "#/$defs/Extent" },
        "depth_m": { "$ref": "#/$defs/Extent" },
        "spacing_m": { "$ref": "#/$defs/Spacing" },
        "elevation_m": { "type": "number" },
        "seed": { "$ref": "#/$defs/Seed" },
        "noise_amplitude_m": { "type": "number", "minimum": 0, "maximum": 3 },
        "noise_scale_m": { "type": "number", "minimum": 0.25, "maximum": 50 }
      }
    },
    "SlopeTerrainSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain_spec_version", "kind", "width_m", "depth_m", "spacing_m",
        "elevation_m", "seed", "noise_amplitude_m", "noise_scale_m",
        "angle_deg", "direction"
      ],
      "properties": {
        "terrain_spec_version": { "const": "terrain-spec-v1" },
        "kind": { "const": "slope" },
        "width_m": { "$ref": "#/$defs/Extent" },
        "depth_m": { "$ref": "#/$defs/Extent" },
        "spacing_m": { "$ref": "#/$defs/Spacing" },
        "elevation_m": { "type": "number" },
        "seed": { "$ref": "#/$defs/Seed" },
        "noise_amplitude_m": { "type": "number", "minimum": 0, "maximum": 3 },
        "noise_scale_m": { "type": "number", "minimum": 0.25, "maximum": 50 },
        "angle_deg": { "type": "number", "minimum": -45, "maximum": 45 },
        "direction": { "enum": ["north", "south", "east", "west"] }
      }
    },
    "TrenchTerrainSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain_spec_version", "kind", "width_m", "depth_m", "spacing_m",
        "elevation_m", "seed", "noise_amplitude_m", "noise_scale_m",
        "position", "top_width_m", "bottom_width_m", "trench_depth_m", "wall_steepness"
      ],
      "properties": {
        "terrain_spec_version": { "const": "terrain-spec-v1" },
        "kind": { "const": "trench" },
        "width_m": { "$ref": "#/$defs/Extent" },
        "depth_m": { "$ref": "#/$defs/Extent" },
        "spacing_m": { "$ref": "#/$defs/Spacing" },
        "elevation_m": { "type": "number" },
        "seed": { "$ref": "#/$defs/Seed" },
        "noise_amplitude_m": { "type": "number", "minimum": 0, "maximum": 3 },
        "noise_scale_m": { "type": "number", "minimum": 0.25, "maximum": 50 },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_width_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "bottom_width_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "trench_depth_m": { "type": "number", "minimum": 0, "maximum": 10 },
        "wall_steepness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ProfileTerrainSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain_spec_version", "kind", "width_m", "depth_m", "spacing_m",
        "elevation_m", "seed", "noise_amplitude_m", "noise_scale_m",
        "alignment_xy_m", "section_uv_m", "outside_elevation_m"
      ],
      "properties": {
        "terrain_spec_version": { "const": "terrain-spec-v1" },
        "kind": { "const": "profile" },
        "width_m": { "$ref": "#/$defs/Extent" },
        "depth_m": { "$ref": "#/$defs/Extent" },
        "spacing_m": { "$ref": "#/$defs/Spacing" },
        "elevation_m": { "type": "number" },
        "seed": { "$ref": "#/$defs/Seed" },
        "noise_amplitude_m": { "type": "number", "minimum": 0, "maximum": 3 },
        "noise_scale_m": { "type": "number", "minimum": 0.25, "maximum": 50 },
        "alignment_xy_m": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": { "$ref": "#/$defs/Point2" }
        },
        "section_uv_m": {
          "type": "array", "minItems": 2, "maxItems": 64,
          "items": { "$ref": "#/$defs/Point2" }
        },
        "outside_elevation_m": { "type": "number" }
      }
    }
  }
}
