{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excavatorsim.local/protocol/physics-rig-v1.schema.json",
  "title": "Excavator Physics Rig Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rig_id", "rig_version", "model_id", "model_version", "coordinate_basis", "provenance", "collision_layers", "self_collision_mode", "bodies", "joints", "chassis_dynamics", "tracks", "quality_flags"],
  "properties": {
    "schema_version": {"const": "physics-rig-v1"},
    "rig_id": {"type": "string", "minLength": 1},
    "rig_version": {"type": "string", "minLength": 1},
    "model_id": {"enum": ["sy205", "sy135"]},
    "model_version": {"type": "string", "minLength": 1},
    "coordinate_basis": {"const": "godot-y-up-right-handed-meters"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_paths", "notes"],
      "properties": {
        "status": {"enum": ["observed", "derived", "provisional"]},
        "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "collision_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "terrain", "payload"],
      "properties": {
        "machine": {"type": "integer", "minimum": 1, "maximum": 32},
        "terrain": {"type": "integer", "minimum": 1, "maximum": 32},
        "payload": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "self_collision_mode": {"enum": ["disabled_provisional", "non_adjacent"]},
    "bodies": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/body"}
    },
    "joints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/joint"}
    },
    "chassis_dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mass_kg", "center_of_mass_m", "inertia_diagonal_kg_m2", "linear_damp", "angular_damp", "max_linear_speed_m_s", "max_angular_speed_rad_s", "attitude_stiffness_nm_per_rad", "attitude_damping_nm_s_per_rad", "max_attitude_torque_nm", "ground_clearance_m", "can_sleep", "continuous_collision_detection", "compound_shapes"],
      "properties": {
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "center_of_mass_m": {"$ref": "#/$defs/vec3"},
        "inertia_diagonal_kg_m2": {"$ref": "#/$defs/positive_vec3"},
        "linear_damp": {"type": "number", "minimum": 0},
        "angular_damp": {"type": "number", "minimum": 0},
        "max_linear_speed_m_s": {"type": "number", "exclusiveMinimum": 0},
        "max_angular_speed_rad_s": {"type": "number", "exclusiveMinimum": 0},
        "ground_clearance_m": {"type": "number", "exclusiveMinimum": 0},
        "can_sleep": {"type": "boolean"},
        "continuous_collision_detection": {"type": "boolean"},
        "attitude_stiffness_nm_per_rad": {"type": "number", "exclusiveMinimum": 0},
        "attitude_damping_nm_s_per_rad": {"type": "number", "exclusiveMinimum": 0},
        "max_attitude_torque_nm": {"type": "number", "exclusiveMinimum": 0},
        "compound_shapes": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/phase1_shape"}}
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gauge_m", "contact_length_m", "contact_width_m", "traction_points_per_side", "friction", "max_drive_force_n", "max_belt_speed_m_s", "brake_force_n", "traction_response_n_per_m_s", "lateral_resistance_n_per_m_s", "probe_height_m", "probe_depth_m", "support_rest_length_m", "support_stiffness_n_per_m", "support_damping_n_s_per_m", "max_support_force_n", "pivot_lateral_resistance_scale", "yaw_assist_scale"],
      "properties": {
        "gauge_m": {"type": "number", "exclusiveMinimum": 0},
        "contact_length_m": {"type": "number", "exclusiveMinimum": 0},
        "contact_width_m": {"type": "number", "exclusiveMinimum": 0},
        "traction_points_per_side": {"type": "integer", "minimum": 2, "maximum": 16},
        "friction": {"type": "number", "minimum": 0, "maximum": 4},
        "max_drive_force_n": {"type": "number", "exclusiveMinimum": 0},
        "max_belt_speed_m_s": {"type": "number", "exclusiveMinimum": 0},
        "brake_force_n": {"type": "number", "exclusiveMinimum": 0},
        "traction_response_n_per_m_s": {"type": "number", "exclusiveMinimum": 0},
        "lateral_resistance_n_per_m_s": {"type": "number", "exclusiveMinimum": 0},
        "probe_height_m": {"type": "number", "exclusiveMinimum": 0},
        "probe_depth_m": {"type": "number", "exclusiveMinimum": 0},
        "support_rest_length_m": {"type": "number", "exclusiveMinimum": 0},
        "support_stiffness_n_per_m": {"type": "number", "exclusiveMinimum": 0},
        "support_damping_n_s_per_m": {"type": "number", "exclusiveMinimum": 0},
        "max_support_force_n": {"type": "number", "exclusiveMinimum": 0},
        "pivot_lateral_resistance_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "yaw_assist_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "drive_effort_slew_n_per_tick": {"type": "number", "exclusiveMinimum": 0},
        "brake_effort_slew_n_per_tick": {"type": "number", "exclusiveMinimum": 0},
        "acceleration_window_s": {"type": "number", "exclusiveMinimum": 0},
        "brake_stop_window_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "quality_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "positive_vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
    "row4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "transform_rows": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/row4"},
        {"$ref": "#/$defs/row4"},
        {"$ref": "#/$defs/row4"},
        {
          "type": "array",
          "prefixItems": [{"const": 0.0}, {"const": 0.0}, {"const": 0.0}, {"const": 1.0}],
          "items": false
        }
      ],
      "items": false
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "center_m", "size_m"],
      "properties": {
        "kind": {"enum": ["box", "capsule", "convex_proxy"]},
        "center_m": {"$ref": "#/$defs/vec3"},
        "size_m": {"$ref": "#/$defs/positive_vec3"}
      }
    },
    "phase1_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "center_m", "size_m"],
      "properties": {
        "kind": {"const": "box"},
        "center_m": {"$ref": "#/$defs/vec3"},
        "size_m": {"$ref": "#/$defs/positive_vec3"}
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "frame", "rest_transform_godot", "mass_kg", "center_of_mass_m", "inertia_diagonal_kg_m2", "shape"],
      "properties": {
        "name": {"enum": ["chassis", "upper", "boom", "arm", "bucket"]},
        "frame": {"enum": ["base_link", "upper_structure_link", "boom_link", "arm_link", "bucket_link"]},
        "rest_transform_godot": {"$ref": "#/$defs/transform_rows"},
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "center_of_mass_m": {"$ref": "#/$defs/vec3"},
        "inertia_diagonal_kg_m2": {"$ref": "#/$defs/positive_vec3"},
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "center_m", "size_m"],
          "properties": {
            "kind": {"enum": ["box", "capsule", "convex_proxy"]},
            "center_m": {"$ref": "#/$defs/vec3"},
            "size_m": {"$ref": "#/$defs/positive_vec3"}
          }
        }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "parent_body", "child_body", "frame", "parent_anchor_godot", "child_anchor_godot", "axis", "axis_frame", "limit_rad", "collide_connected", "actuator"],
      "properties": {
        "name": {"enum": ["swing_joint", "boom_joint", "arm_joint", "bucket_joint"]},
        "type": {"enum": ["hinge", "continuous_hinge"]},
        "parent_body": {"enum": ["chassis", "upper", "boom", "arm"]},
        "child_body": {"enum": ["upper", "boom", "arm", "bucket"]},
        "frame": {"type": "string", "minLength": 1},
        "parent_anchor_godot": {"$ref": "#/$defs/transform_rows"},
        "child_anchor_godot": {"$ref": "#/$defs/transform_rows"},
        "axis": {"$ref": "#/$defs/vec3"},
        "axis_frame": {"const": "child_anchor_local"},
        "limit_rad": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "collide_connected": {"type": "boolean"},
        "actuator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "max_torque_nm", "max_velocity_rad_s", "max_acceleration_rad_s2", "max_jerk_rad_s3", "damping"],
          "properties": {
            "mode": {"const": "velocity_motor"},
            "max_torque_nm": {"type": "number", "exclusiveMinimum": 0},
            "max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0},
            "max_acceleration_rad_s2": {"type": "number", "exclusiveMinimum": 0},
            "max_jerk_rad_s3": {"type": "number", "exclusiveMinimum": 0},
            "damping": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
