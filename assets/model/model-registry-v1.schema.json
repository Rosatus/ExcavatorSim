{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-pinocchio.local/assets/model/model-registry-v1.schema.json",
  "title": "ExcavatorModelRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_model_id", "models"],
  "properties": {
    "schema_version": {"const": "excavator-model-registry-v1"},
    "default_model_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ModelDescriptor"}
    }
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "RepositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$"
    },
    "ResourcePath": {"type": "string", "pattern": "^res://.+"},
    "ExcavationContact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "frame", "offset_godot"],
          "properties": {
            "mode": {"const": "frame_offset"},
            "frame": {"const": "bucket_link"},
            "offset_godot": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "number"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "frame", "node_path"],
          "properties": {
            "mode": {"const": "node"},
            "frame": {"const": "bucket_link"},
            "node_path": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "ModelDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "display_name",
        "model_version",
        "visual_model_version",
        "urdf_path",
        "urdf_sha256",
        "calibration_path",
        "calibration_sha256",
        "calibration_version",
        "godot_glb_path",
        "godot_glb_resource",
        "godot_glb_sha256",
        "visual_manifest_path",
        "visual_manifest_resource",
        "visual_manifest_sha256",
        "parity_fixture_path",
        "parity_fixture_resource",
        "parity_fixture_sha256",
        "passive_linkage_mode",
        "excavation_contact"
      ],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "display_name": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "visual_model_version": {"type": "string", "minLength": 1},
        "urdf_path": {"$ref": "#/$defs/RepositoryPath"},
        "urdf_sha256": {"$ref": "#/$defs/Sha256"},
        "calibration_path": {"$ref": "#/$defs/RepositoryPath"},
        "calibration_sha256": {"$ref": "#/$defs/Sha256"},
        "calibration_version": {"type": "string", "minLength": 1},
        "godot_glb_path": {"$ref": "#/$defs/RepositoryPath"},
        "godot_glb_resource": {"$ref": "#/$defs/ResourcePath"},
        "godot_glb_sha256": {"$ref": "#/$defs/Sha256"},
        "visual_manifest_path": {"$ref": "#/$defs/RepositoryPath"},
        "visual_manifest_resource": {"$ref": "#/$defs/ResourcePath"},
        "visual_manifest_sha256": {"$ref": "#/$defs/Sha256"},
        "parity_fixture_path": {"$ref": "#/$defs/RepositoryPath"},
        "parity_fixture_resource": {"$ref": "#/$defs/ResourcePath"},
        "parity_fixture_sha256": {"$ref": "#/$defs/Sha256"},
        "passive_linkage_mode": {"enum": ["godot_visual_four_bar", "none"]},
        "excavation_contact": {"$ref": "#/$defs/ExcavationContact"}
      }
    }
  }
}
